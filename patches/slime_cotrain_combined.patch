@@ -472,6 +472,30 @@ class RolloutManager:
         num_new = srv.num_new_engines if srv else 0
         return engines, self.rollout_engine_lock, num_new, gpu_counts, gpu_offsets
 
+    def get_server_engines_and_lock(self, server_name: str):
+        """Return engines for a specific named server.
+
+        Like get_updatable_engines_and_lock() but routes by model name.
+        Used by dual-model co-training where each training group updates
+        only its own model's engines. Port of simonucl/slime@3b7cd12e.
+        """
+        srv = self.servers.get(server_name)
+        if srv is None:
+            return [], self.rollout_engine_lock, 0, [], []
+        return (
+            srv.engines,
+            self.rollout_engine_lock,
+            srv.num_new_engines,
+            srv.engine_gpu_counts,
+            srv.engine_gpu_offsets,
+        )
+
+    def clear_server_num_new_engines(self, server_name: str):
+        """Clear num_new_engines for a specific named server."""
+        srv = self.servers.get(server_name)
+        if srv:
+            srv.num_new_engines = 0
+
     def get_num_rollout_per_epoch(self):
