diff --git a/slime/utils/timer.py b/slime/utils/timer.py
index ec1bdf76..00c5f9e4 100644
--- a/slime/utils/timer.py
+++ b/slime/utils/timer.py
@@ -82,10 +82,18 @@ def timer(name_or_func):
 
 @contextmanager
 def inverse_timer(name):
-    Timer().end(name)
+    # Be forgiving if the outer "wait" timer wasn't started yet (e.g. the
+    # very first call before any with_defer has primed it) — start/end is
+    # cheap and the semantics of "end if started, always re-start for next
+    # iteration" are what every call site expects.
+    if name in Timer().start_time:
+        Timer().end(name)
     try:
         yield
     finally:
+        if name in Timer().start_time:
+            # Already re-started by a nested call — don't double-start.
+            return
         Timer().start(name)
 
 
