# Copy to .env and fill in real values. Never commit .env.

# Database
# Use a strong password (e.g. `openssl rand -base64 32`). Must match the
# POSTGRES_PASSWORD set in deploy/.env when running via docker-compose.
DATABASE_URL=postgresql+psycopg://usim:REPLACE_ME@localhost:5432/usim_study

# Frontend origin (for CORS in dev). In production, cloudflared fronts the same
# origin so this can be left blank.
FRONTEND_ORIGIN=http://localhost:3000

# OpenAI (one key per condition if you want stricter isolation; for pilot a
# single key is fine)
OPENAI_API_KEY=<your OpenAI API key>

# Model used for each condition. Will be swapped to SGLang endpoints later.
MODEL_BASE=gpt-5.4
MODEL_RL_SINGLE=gpt-5.4
MODEL_COTRAINING=gpt-5.4

# Optional: per-condition base URLs if using separate SGLang endpoints.
# Leave blank to use the default OpenAI API.
OPENAI_BASE_URL_BASE=
OPENAI_BASE_URL_RL_SINGLE=
OPENAI_BASE_URL_COTRAINING=

# Completion-code secret — used to HMAC-sign Prolific completion codes so
# participants can't forge them.
COMPLETION_CODE_SECRET=change-me-in-production

# Session limits
MAX_TURNS=30
MAX_SESSION_SECONDS=2400
