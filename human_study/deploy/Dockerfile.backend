# Build context is the human_study/ root (see docker-compose.yml).
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

WORKDIR /app
COPY backend/pyproject.toml ./
RUN pip install --no-cache-dir \
    "fastapi>=0.115" "uvicorn[standard]>=0.32" \
    "sqlmodel>=0.0.22" "psycopg[binary]>=3.2" "pydantic>=2.9" \
    "pydantic-settings>=2.6" "openai>=1.54" "httpx>=0.27" "pyyaml>=6.0" \
    "python-multipart>=0.0.12"

COPY backend/app ./app
# tasks/ and surveys/ live at the parent of /app so that tasks.py's
# Path(__file__).parents[2].parent / "tasks" resolves correctly inside the
# container (mirroring the layout in the repo).
COPY tasks /tasks
COPY surveys /surveys

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
